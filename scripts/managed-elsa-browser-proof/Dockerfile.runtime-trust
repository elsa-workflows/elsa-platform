ARG RUNTIME_IMAGE=valenceruntimeimages.azurecr.io/runtime-combined@sha256:c167eac48374cdf653e0bc21b54f50dc22b44f9e8b67f90d1b2c22ff152ebf09

FROM debian:bookworm-slim AS trust
COPY local-root-ca.crt /usr/local/share/ca-certificates/elsa-managed-browser-proof.crt
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

FROM ${RUNTIME_IMAGE}
COPY --from=trust /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
