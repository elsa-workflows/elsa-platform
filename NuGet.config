<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="consolelogstreaming-preview" value="https://f.feedz.io/valence-works/consolelogstream/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="consolelogstreaming-preview">
      <package pattern="ConsoleLogStreaming.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
