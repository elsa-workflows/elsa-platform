<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Temporary coordinated-development feed. Remove after the Foundation package is published. -->
    <add key="healing-local" value="artifacts/healing-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="consolelogstreaming-preview" value="https://f.feedz.io/valence-works/consolelogstream/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="healing-local">
      <package pattern="Elsa.Diagnostics.OpenTelemetry*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="consolelogstreaming-preview">
      <package pattern="ConsoleLogStreaming.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
