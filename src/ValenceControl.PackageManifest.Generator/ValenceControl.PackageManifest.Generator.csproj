<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>ValenceControl.PackageManifest.Generator</PackageId>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ValenceControl.PackageManifest.Generator.MSBuild\ValenceControl.PackageManifest.Generator.MSBuild.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build/**/*.*" Pack="true" PackagePath="build/" />
    <None Include="buildTransitive/**/*.*" Pack="true" PackagePath="buildTransitive/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <Content Include="src/ValenceControl.PackageManifest.Generator.Hints/**/*.cs" Pack="true" PackagePath="contentFiles/cs/any/ValenceControl.PackageManifest.Generator.Hints/" BuildAction="Compile" />
    <Content Include="../ValenceControl.PackageManifest.Generator.MSBuild/bin/$(Configuration)/$(TargetFramework)/*.dll" Pack="true" PackagePath="tasks/" Condition="Exists('../ValenceControl.PackageManifest.Generator.MSBuild/bin/$(Configuration)/$(TargetFramework)/ValenceControl.PackageManifest.Generator.MSBuild.dll')" />
    <Content Include="../ValenceControl.PackageManifest.Generator.MSBuild/bin/$(Configuration)/$(TargetFramework)/ValenceControl.PackageManifest.Generator.MSBuild.deps.json" Pack="true" PackagePath="tasks/" Condition="Exists('../ValenceControl.PackageManifest.Generator.MSBuild/bin/$(Configuration)/$(TargetFramework)/ValenceControl.PackageManifest.Generator.MSBuild.deps.json')" />
  </ItemGroup>
</Project>
