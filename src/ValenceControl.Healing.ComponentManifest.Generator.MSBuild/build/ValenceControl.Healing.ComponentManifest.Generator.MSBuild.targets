<Project>
  <PropertyGroup>
    <GenerateValenceControlHealingComponentManifest Condition="'$(GenerateValenceControlHealingComponentManifest)' == ''">true</GenerateValenceControlHealingComponentManifest>
    <ValenceControlHealingRequireSourceRevision Condition="'$(ValenceControlHealingRequireSourceRevision)' == ''">true</ValenceControlHealingRequireSourceRevision>
    <ValenceControlHealingSourceRevision Condition="'$(ValenceControlHealingSourceRevision)' == '' and '$(SourceRevisionId)' != ''">$(SourceRevisionId)</ValenceControlHealingSourceRevision>
    <ValenceControlHealingSourceRevision Condition="'$(ValenceControlHealingSourceRevision)' == '' and '$(RepositoryCommit)' != ''">$(RepositoryCommit)</ValenceControlHealingSourceRevision>
    <ValenceControlHealingRepositoryUrl Condition="'$(ValenceControlHealingRepositoryUrl)' == ''">$(RepositoryUrl)</ValenceControlHealingRepositoryUrl>
    <ValenceControlHealingBuildId Condition="'$(ValenceControlHealingBuildId)' == ''">$(BuildNumber)</ValenceControlHealingBuildId>
    <ValenceControlHealingComponentManifestOutputPath Condition="'$(ValenceControlHealingComponentManifestOutputPath)' == ''">$(TargetDir)valence-control-healing-component-manifest.json</ValenceControlHealingComponentManifestOutputPath>
  </PropertyGroup>

  <UsingTask
    TaskName="ValenceControl.Healing.ComponentManifest.Generator.MSBuild.GenerateHealingComponentManifestTask"
    AssemblyFile="$(MSBuildThisFileDirectory)..\tasks\ValenceControl.Healing.ComponentManifest.Generator.MSBuild.dll"
    Condition="Exists('$(MSBuildThisFileDirectory)..\tasks\ValenceControl.Healing.ComponentManifest.Generator.MSBuild.dll')" />

  <Target Name="GenerateValenceControlHealingComponentManifest"
          AfterTargets="Build"
          DependsOnTargets="ResolvePackageAssets"
          Condition="'$(GenerateValenceControlHealingComponentManifest)' == 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <GenerateHealingComponentManifestTask
      ProjectAssetsFile="$(ProjectAssetsFile)"
      ProjectDirectory="$(MSBuildProjectDirectory)"
      ApplicationAssemblyPath="$(TargetPath)"
      OutputPath="$(ValenceControlHealingComponentManifestOutputPath)"
      ApplicationName="$(AssemblyName)"
      ApplicationVersion="$(Version)"
      TargetFramework="$(TargetFramework)"
      RuntimeIdentifier="$(RuntimeIdentifier)"
      SourceRevision="$(ValenceControlHealingSourceRevision)"
      RepositoryUrl="$(ValenceControlHealingRepositoryUrl)"
      BuildId="$(ValenceControlHealingBuildId)"
      CreatedAt="$(ValenceControlHealingManifestCreatedAt)"
      RequireSourceRevision="$(ValenceControlHealingRequireSourceRevision)" />

    <ItemGroup>
      <FileWrites Include="$(ValenceControlHealingComponentManifestOutputPath)" />
      <ValenceControlHealingComponentManifest Include="$(ValenceControlHealingComponentManifestOutputPath)" />
    </ItemGroup>
  </Target>

  <Target Name="CleanValenceControlHealingComponentManifest"
          AfterTargets="Clean"
          Condition="'$(IsCrossTargetingBuild)' != 'true'">
    <Delete Files="$(ValenceControlHealingComponentManifestOutputPath)" />
  </Target>
</Project>
