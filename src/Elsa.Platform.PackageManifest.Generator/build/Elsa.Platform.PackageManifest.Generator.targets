<Project>
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage Condition="'$(ElsaPackageManifestIncludeInPackage)' == 'true' and '$(GenerateElsaPackageManifest)' == 'true'">$(TargetsForTfmSpecificContentInPackage);_ElsaPackageManifestGetPackageFiles</TargetsForTfmSpecificContentInPackage>
    <_ElsaPackageManifestGenerateForPack Condition="'$(NoBuild)' != 'true'">GenerateElsaPackageManifest</_ElsaPackageManifestGenerateForPack>
  </PropertyGroup>

  <UsingTask
    TaskName="Elsa.Platform.PackageManifest.Generator.MSBuild.GenerateElsaPackageManifestTask"
    AssemblyFile="$(MSBuildThisFileDirectory)..\tasks\Elsa.Platform.PackageManifest.Generator.MSBuild.dll"
    Condition="Exists('$(MSBuildThisFileDirectory)..\tasks\Elsa.Platform.PackageManifest.Generator.MSBuild.dll')" />

  <Target Name="GenerateElsaPackageManifest"
          AfterTargets="Build"
          BeforeTargets="GenerateNuspec"
          Condition="'$(GenerateElsaPackageManifest)' == 'true' and '$(NoBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <PropertyGroup>
      <_ElsaPackageManifestOverrideFile Condition="'$(ElsaPackageManifestOverrideFile)' != ''">$(ElsaPackageManifestOverrideFile)</_ElsaPackageManifestOverrideFile>
      <_ElsaPackageManifestOverrideFile Condition="'$(_ElsaPackageManifestOverrideFile)' == '' and Exists('$(MSBuildProjectDirectory)\elsa-package.overrides.json')">$(MSBuildProjectDirectory)\elsa-package.overrides.json</_ElsaPackageManifestOverrideFile>
      <_ElsaPackageManifestOutputPath Condition="'$(ElsaPackageManifestOutputPath)' != ''">$(ElsaPackageManifestOutputPath)</_ElsaPackageManifestOutputPath>
      <_ElsaPackageManifestOutputPath Condition="'$(_ElsaPackageManifestOutputPath)' == ''">$(IntermediateOutputPath)elsa-package.json</_ElsaPackageManifestOutputPath>
      <_ElsaPackageManifestCanonicalTargetFramework Condition="'$(TargetFrameworks)' != ''">$([System.String]::Copy('$(TargetFrameworks)').Split(';')[0].Trim())</_ElsaPackageManifestCanonicalTargetFramework>
      <_ElsaPackageManifestCanonicalTargetFramework Condition="'$(_ElsaPackageManifestCanonicalTargetFramework)' == ''">$(TargetFramework)</_ElsaPackageManifestCanonicalTargetFramework>
    </PropertyGroup>

    <GenerateElsaPackageManifestTask
      AssemblyPath="$(TargetPath)"
      XmlDocumentationPath="$(DocumentationFile)"
      OutputPath="$(_ElsaPackageManifestOutputPath)"
      OverrideFile="$(_ElsaPackageManifestOverrideFile)"
      PackageId="$(PackageId)"
      Version="$(PackageVersion)"
      Title="$(Title)"
      Description="$(Description)"
      Authors="$(Authors)"
      RepositoryUrl="$(RepositoryUrl)"
      PackageProjectUrl="$(PackageProjectUrl)"
      PackageTags="$(PackageTags)"
      PackageLicenseExpression="$(PackageLicenseExpression)"
      PackageReadmeFile="$(PackageReadmeFile)"
      TargetFramework="$(TargetFramework)"
      TargetFrameworks="$(TargetFrameworks)"
      ValidationSeverity="$(ElsaPackageManifestValidationSeverity)"
      Strict="$(ElsaPackageManifestStrict)"
      FailOnWarnings="$(ElsaPackageManifestFailOnWarnings)"
      AllowTargetFrameworkDifferences="$(ElsaPackageManifestAllowTargetFrameworkDifferences)"
      DiagnosticsVerbosity="$(ElsaPackageManifestDiagnosticsVerbosity)"
      AdditionalFeatureInterfaceTypes="$(ElsaPackageManifestAdditionalFeatureInterfaceTypes)"
      ReferenceAssemblyPaths="@(ReferencePath)" />

    <ItemGroup>
      <_ElsaPackageManifestGeneratedFile Include="$(_ElsaPackageManifestOutputPath)" />
    </ItemGroup>
  </Target>

  <Target Name="_ElsaPackageManifestGetPackageFiles"
          DependsOnTargets="$(_ElsaPackageManifestGenerateForPack)"
          Condition="'$(GenerateElsaPackageManifest)' == 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <PropertyGroup>
      <_ElsaPackageManifestOutputPath Condition="'$(ElsaPackageManifestOutputPath)' != ''">$(ElsaPackageManifestOutputPath)</_ElsaPackageManifestOutputPath>
      <_ElsaPackageManifestOutputPath Condition="'$(_ElsaPackageManifestOutputPath)' == ''">$(IntermediateOutputPath)elsa-package.json</_ElsaPackageManifestOutputPath>
      <_ElsaPackageManifestCanonicalTargetFramework Condition="'$(TargetFrameworks)' != ''">$([System.String]::Copy('$(TargetFrameworks)').Split(';')[0].Trim())</_ElsaPackageManifestCanonicalTargetFramework>
      <_ElsaPackageManifestCanonicalTargetFramework Condition="'$(_ElsaPackageManifestCanonicalTargetFramework)' == ''">$(TargetFramework)</_ElsaPackageManifestCanonicalTargetFramework>
    </PropertyGroup>

    <Error Condition="'$(ElsaPackageManifestIncludeInPackage)' == 'true' and '$(NoBuild)' == 'true' and !Exists('$(_ElsaPackageManifestOutputPath)') and ('$(TargetFrameworks)' == '' or '$(TargetFramework)' == '$(_ElsaPackageManifestCanonicalTargetFramework)')"
           Text="Elsa package manifest was not found at '$(_ElsaPackageManifestOutputPath)' during dotnet pack --no-build. Run dotnet build for configuration '$(Configuration)' before packing, run dotnet pack without --no-build, or disable manifest package inclusion with ElsaPackageManifestIncludeInPackage=false." />

    <ItemGroup Condition="'$(ElsaPackageManifestIncludeInPackage)' == 'true' and Exists('$(_ElsaPackageManifestOutputPath)') and ('$(TargetFrameworks)' == '' or '$(TargetFramework)' == '$(_ElsaPackageManifestCanonicalTargetFramework)')">
      <TfmSpecificPackageFile Include="$(_ElsaPackageManifestOutputPath)"
                              PackagePath="$(ElsaPackageManifestPackagePath)" />
    </ItemGroup>

    <Message Condition="'@(TfmSpecificPackageFile)' != ''"
             Importance="Low"
             Text="Including Elsa package manifest '$(_ElsaPackageManifestOutputPath)' as package entry '$(ElsaPackageManifestPackagePath)' from target framework '$(TargetFramework)'." />
  </Target>
</Project>
