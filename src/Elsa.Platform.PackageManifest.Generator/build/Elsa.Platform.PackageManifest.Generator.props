<Project>
  <PropertyGroup>
    <GenerateElsaPackageManifest Condition="'$(GenerateElsaPackageManifest)' == ''">true</GenerateElsaPackageManifest>
    <ElsaPackageManifestIncludeInPackage Condition="'$(ElsaPackageManifestIncludeInPackage)' == ''">true</ElsaPackageManifestIncludeInPackage>
    <ElsaPackageManifestPackagePath Condition="'$(ElsaPackageManifestPackagePath)' == ''">elsa-package.json</ElsaPackageManifestPackagePath>
    <ElsaPackageManifestValidationSeverity Condition="'$(ElsaPackageManifestValidationSeverity)' == ''">Error</ElsaPackageManifestValidationSeverity>
    <ElsaPackageManifestStrict Condition="'$(ElsaPackageManifestStrict)' == ''">false</ElsaPackageManifestStrict>
    <ElsaPackageManifestFailOnWarnings Condition="'$(ElsaPackageManifestFailOnWarnings)' == ''">false</ElsaPackageManifestFailOnWarnings>
    <ElsaPackageManifestAllowTargetFrameworkDifferences Condition="'$(ElsaPackageManifestAllowTargetFrameworkDifferences)' == ''">false</ElsaPackageManifestAllowTargetFrameworkDifferences>
    <ElsaPackageManifestDiagnosticsVerbosity Condition="'$(ElsaPackageManifestDiagnosticsVerbosity)' == ''">concise</ElsaPackageManifestDiagnosticsVerbosity>
  </PropertyGroup>
</Project>
