{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Elsa.Platform.PackageCatalog.Core.Sync": "Information",
      "Elsa.Platform.PackageCatalog.PackageValidation": "Information",
      "Elsa.Platform.PackageCatalog.Approvals": "Information",
      "Elsa.Platform.PackageCatalog.SuspiciousChanges": "Warning"
    }
  },
  "Sync": {
    "Scheduled": {
      "Enabled": false,
      "Interval": "01:00:00"
    }
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "AllowedHosts": "*"
}
