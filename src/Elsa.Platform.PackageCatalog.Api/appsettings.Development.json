{
  "ConnectionStrings": {
    "Catalog": "Data Source=elsa-catalog-dev.db"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "Authentication": {
    "ApiKey": "local-dev-key",
    "WorkspaceTrustedHeaders": {
      "Enabled": true,
      "AllowedProxyNetworks": "127.0.0.1/32,::1/128"
    }
  },
  "Sync": {
    "Scheduled": {
      "Enabled": false,
      "Interval": "00:30:00"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
