{
  "ConnectionStrings": {
    "Catalog": "Data Source=elsa-catalog-dev.db",
    "Healing": "Data Source=elsa-healing-dev.db"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "DataProtection": {
    "KeysPath": ".data-protection-keys"
  },
  "Authentication": {
    "ApiKey": "local-dev-key",
    "PlatformIdentity": {
      "Provider": "GenericOidc",
      "Authority": "",
      "Audience": "elsa-platform-dev",
      "Issuer": "https://local.elsa-platform.test",
      "ClientId": "",
      "ClientSecret": "",
      "Scopes": [ "openid", "profile", "email" ],
      "RedirectUri": "/api/auth/callback",
      "PostLogoutRedirectUri": "/admin",
      "SymmetricSigningKey": "local-development-platform-identity-signing-key-change-me",
      "RequireHttpsMetadata": false,
      "Claims": {
        "Subject": "sub",
        "DisplayName": [ "name" ],
        "Email": [ "email" ]
      }
    },
    "WorkspaceTrustedHeaders": {
      "Enabled": false,
      "AllowedProxyNetworks": "127.0.0.1/32,::1/128"
    }
  },
  "Sync": {
    "Scheduled": {
      "Enabled": false,
      "Interval": "00:30:00"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
