{
  "Diagnostics": {
    "IdentityModel": {
      "ShowPII": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Elsa.Platform.PackageCatalog.Core.Sync": "Information",
      "Elsa.Platform.PackageCatalog.PackageValidation": "Information",
      "Elsa.Platform.PackageCatalog.Approvals": "Information",
      "Elsa.Platform.PackageCatalog.SuspiciousChanges": "Warning"
    }
  },
  "Sync": {
    "Scheduled": {
      "Enabled": false,
      "Interval": "01:00:00"
    }
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "Healing": {
    "PlatformKillSwitch": false,
    "DiscoveryEnabled": true,
    "IncidentReviewEnabled": true,
    "RepairDispatchEnabled": false,
    "AutomaticMergeEnabled": false,
    "VerificationEnabled": true,
    "LeaseDuration": "00:05:00",
    "LeaseSafetyMargin": "00:00:15",
    "IdleDelay": "00:00:02",
    "RetryDelay": "00:01:00",
    "Workers": {
      "Enabled": false
    },
    "Database": {
      "Provider": "Sqlite"
    },
    "Budgets": {
      "TimeBudget": "00:30:00",
      "MaxConcurrentOperations": 4,
      "MaxInferenceUnits": 200000,
      "MaxRepositoryRuns": 2,
      "MaxRepairAttempts": 2
    }
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "Deployment": {
    "QueueWorker": {
      "Enabled": false
    },
    "WebhookDispatch": {
      "Enabled": false,
      "BatchSize": 25,
      "PollInterval": "00:00:15",
      "NotificationPath": "/api/elsa-platform/deployment-command-notifications"
    },
    "EngineVerification": {
      "Enabled": true,
      "BatchSize": 25,
      "PollInterval": "00:05:00",
      "VerificationInterval": "00:15:00"
    }
  },
  "ArtifactUploads": {
    "LocalStorageRoot": "",
    "MaxUploadBytes": 52428800,
    "SessionTtlMinutes": 30
  },
  "Authentication": {
    "PlatformIdentity": {
      "Provider": "GenericOidc",
      "Authority": "",
      "Audience": "",
      "Issuer": "",
      "ClientId": "",
      "ClientSecret": "",
      "Scopes": [ "openid", "profile", "email" ],
      "RedirectUri": "/api/auth/callback",
      "PostLogoutRedirectUri": "/admin",
      "SymmetricSigningKey": "",
      "RequireHttpsMetadata": true,
      "Claims": {
        "Subject": "sub",
        "DisplayName": [ "name" ],
        "Email": [ "email" ]
      }
    },
    "WorkspaceTrustedHeaders": {
      "Enabled": false,
      "AllowedProxyNetworks": ""
    }
  },
  "AllowedHosts": "*"
}
