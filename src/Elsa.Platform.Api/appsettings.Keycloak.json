{
  "ConnectionStrings": {
    "Catalog": "Data Source=elsa-catalog-keycloak.db"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "Console": {
    "DevelopmentUrl": "http://localhost:5173"
  },
  "Authentication": {
    "ApiKey": "local-dev-key",
    "PlatformIdentity": {
      "Provider": "Keycloak",
      "Authority": "http://127.0.0.1:8080/realms/elsa-platform",
      "Audience": "elsa-platform-console",
      "Issuer": "http://127.0.0.1:8080/realms/elsa-platform",
      "ClientId": "elsa-platform-console",
      "ClientSecret": "local-dev-secret",
      "Scopes": [ "openid", "profile", "email" ],
      "RedirectUri": "/api/auth/callback",
      "PostLogoutRedirectUri": "/admin",
      "SymmetricSigningKey": "",
      "RequireHttpsMetadata": false,
      "Claims": {
        "Subject": "sub",
        "DisplayName": [ "name", "preferred_username" ],
        "Email": [ "email" ]
      }
    },
    "WorkspaceTrustedHeaders": {
      "Enabled": false
    }
  },
  "Sync": {
    "Scheduled": {
      "Enabled": false,
      "Interval": "00:30:00"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
