{
  "ConnectionStrings": {
    "Catalog": "Data Source=valence-control-catalog-keycloak.db",
    "Healing": "Data Source=valence-control-healing-keycloak.db"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "DataProtection": {
    "KeysPath": ".data-protection-keys-keycloak"
  },
  "Console": {
    "DevelopmentUrl": "http://localhost:5173"
  },
  "Authentication": {
    "ApiKey": "local-dev-key",
    "ControlIdentity": {
      "Provider": "Keycloak",
      "Authority": "http://127.0.0.1:8080/realms/valence-control",
      "Audience": "valence-control-console",
      "Issuer": "http://127.0.0.1:8080/realms/valence-control",
      "ClientId": "valence-control-console",
      "ClientSecret": "local-dev-secret",
      "Scopes": [ "openid", "profile", "email" ],
      "RedirectUri": "/api/auth/callback",
      "PostLogoutRedirectUri": "/admin",
      "SymmetricSigningKey": "",
      "RequireHttpsMetadata": false,
      "Claims": {
        "Subject": "sub",
        "DisplayName": [ "name", "preferred_username" ],
        "Email": [ "email" ]
      }
    },
    "WorkspaceTrustedHeaders": {
      "Enabled": false
    }
  },
  "Sync": {
    "Scheduled": {
      "Enabled": false,
      "Interval": "00:30:00"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
